{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client", "@cloudflare/workers-types"]
  },
  "include": ["alchemy.run.ts", "vite.config.ts", "src", "test", "runner"],
  "exclude": ["test/fixtures"]
}
