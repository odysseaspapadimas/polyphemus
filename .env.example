# Model-provider credential, bound only to the private Model Proxy Worker.
OPENCODE_API_KEY=

# Independent random secrets for runtime authorization and signed internal claims.
SANDBOX_API_TOKEN=
VALIDATION_POLICY_SIGNING_KEY=
MODEL_GRANT_SIGNING_KEY=

# GitHub App installation used only by RepositoryPublisher after Pi exits.
# Use an installation with Contents and Pull requests read/write access.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM value; escaped \\n newlines are accepted for CI/deployment secrets.
GITHUB_APP_PRIVATE_KEY=
# Account or organization namespace that owns Agent forks and branches.
GITHUB_PUBLISHER_LOGIN=

# Deployment origins and Cloudflare Access settings. Email OTP is used for sign-up/sign-in.
POLYPHEMUS_MODEL_PROXY_ORIGIN=https://polyphemus-model-proxy.example.workers.dev
POLYPHEMUS_ACCESS_DOMAIN=polyphemus.example.workers.dev
POLYPHEMUS_ACCESS_AUTH_DOMAIN=example.cloudflareaccess.com
POLYPHEMUS_ACCESS_ORGANIZATION=example

# Required only by `bun run test:deployed`.
POLYPHEMUS_DEPLOYED_WEBSITE_URL=https://polyphemus.example.workers.dev
POLYPHEMUS_DEPLOYED_REPOSITORY_AGENT_URL=https://polyphemus-repository-agent.example.workers.dev
POLYPHEMUS_DEPLOYED_SANDBOX_RUNTIME_URL=https://polyphemus-sandbox-runtime.example.workers.dev
