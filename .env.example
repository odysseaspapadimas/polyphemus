# Model-provider credential, bound only to the private Model Proxy Worker.
OPENCODE_API_KEY=

# Random shared secret for the private Sandbox runtime and scoped model grants.
SANDBOX_API_TOKEN=

# GitHub App installation used only by RepositoryPublisher after Pi exits.
# Use an installation with Contents and Pull requests read/write access.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM value; escaped \\n newlines are accepted for CI/deployment secrets.
GITHUB_APP_PRIVATE_KEY=
# Account or organization namespace that owns Agent forks and branches.
GITHUB_PUBLISHER_LOGIN=

# Optional Cloudflare Access deployment settings. Email OTP is used for sign-up/sign-in.
POLYPHEMUS_ACCESS_DOMAIN=polyphemus.odysseas-patra.workers.dev
POLYPHEMUS_ACCESS_AUTH_DOMAIN=odysseas-dev.cloudflareaccess.com
POLYPHEMUS_ACCESS_ORGANIZATION=odysseas-dev
